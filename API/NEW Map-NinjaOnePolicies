function Get-NcColor { param($nc)
    if ($ncColors.ContainsKey($nc)) { return $ncColors[$nc] }
    return '#aaaaaa'
}

###############################################################################
#  HTML TREE RENDERER                                                         #
###############################################################################
function Convert-TreeToHTML {
    param($tree)
    if ($tree.Count -eq 0) { return "" }
    $html = "<ul>"
    foreach ($p in $tree) {
        $s            = $p.Stats
        $total        = [int]$s['Total']
        $inherited    = [int]$s['Inherited']
        $assigned     = [int]$s['Assigned']
        $stale        = [int]$s['Stale']
        $withOverrides = [int]$s['WithOverrides']
        $color        = Get-NcColor -nc $p.nodeClass

        $defaultBadge   = if ($p.nodeClassDefault) { "<span class='badge badge-default'>DEFAULT</span>" } else { "" }
        $staleBadge     = if ($stale -gt 0)         { "<span class='badge badge-stale'>$stale STALE</span>" } else { "" }
        $overrideBadge  = if ($withOverrides -gt 0) { "<span class='badge badge-override'>$withOverrides overrides</span>" } else { "" }

        $orgList    = if ($s['Orgs'] -and $s['Orgs'].Count -gt 0) { $s['Orgs'] -join ", " } else { "—" }
        $updatedStr = if ($p.updated) {
            try { [DateTimeOffset]::FromUnixTimeSeconds([long]$p.updated).LocalDateTime.ToString("yyyy-MM-dd") }
            catch { "—" }
        } else { "—" }
        $descBlock  = if ($p.description) {
            $esc = [System.Web.HttpUtility]::HtmlEncode($p.description)
            "<div class='policy-desc'>$esc</div>"
        } else { "" }

        $toggleBtn  = if ($p.Children.Count -gt 0) {
            "<button class='toggle-btn' onclick='toggleNode(this)'>&#9660;</button>"
        } else { "" }

        $nameEsc = [System.Web.HttpUtility]::HtmlEncode($p.name)

        $html += @"
<li data-total="$total">
  <div class='policy-header'>
    $toggleBtn
    <span class='policy-name'>$nameEsc</span>
    $defaultBadge $staleBadge $overrideBadge
  </div>
  $descBlock
  <div class='policy-meta'>
    <span class='nc-badge' style='background:$color'>$($p.nodeClass)</span>
    <span class='meta-item'>ID: $($p.id)</span>
    <span class='meta-item'>Updated: $updatedStr</span>
  </div>
  <div class='device-summary'>
    <span class='ds-total'>&#128421; $total devices</span>
    <span class='ds-inherited'>&#8627; $inherited inherited</span>
    <span class='ds-assigned'>&#128279; $assigned assigned</span>
  </div>
  <div class='org-list'>&#127970; Organisations: $orgList</div>
$(Convert-TreeToHTML -tree $p.Children)
</li>
"@
    }
    $html += "</ul>"
    return $html
}

