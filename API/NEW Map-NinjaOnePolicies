###############################################################################
#  PER-POLICY DEVICE STATS                                                    #
# FIX: cast all IDs to [int] so hashtable key lookups never silently fail    #
# FIX: explicit null/zero guard for policyId to correctly identify inherited #
###############################################################################
$staleThreshold = (Get-Date).AddDays(-$StaleDays)
$deviceStats    = @{}

foreach ($device in $allDevices) {
    # policyId is only present when there is an explicit override.
    # rolePolicyId is the role/location inherited policy — always present.
    $rawPid  = $device.policyId
    $rawRid  = $device.rolePolicyId

    $isAssigned    = ($null -ne $rawPid) -and ("$rawPid" -ne "") -and ([int]$rawPid -ne 0)
    $effectivePid  = if ($isAssigned) { [int]$rawPid } else { [int]$rawRid }
    if (-not $effectivePid) { continue }

    if (-not $deviceStats.ContainsKey($effectivePid)) {
        $deviceStats[$effectivePid] = @{
            Total        = 0
            Inherited    = 0
            Assigned     = 0
            Stale        = 0
            WithOverrides = 0
            Orgs         = [System.Collections.Generic.HashSet[string]]::new()
        }
    }

    $s = $deviceStats[$effectivePid]
    $s['Total']++
    if ($isAssigned) { $s['Assigned']++  }
    else             { $s['Inherited']++ }

    if ($device.lastContact) {
        try {
            $lc = [DateTimeOffset]::FromUnixTimeSeconds([long]$device.lastContact).LocalDateTime
            if ($lc -lt $staleThreshold) { $s['Stale']++ }
        } catch {}
    }

    if ($device.organizationId -and $orgLookup.ContainsKey([int]$device.organizationId)) {
        [void]$s['Orgs'].Add($orgLookup[[int]$device.organizationId])
    }
}

###############################################################################
#  OVERRIDE LOOKUPS                                                           #
# Build two tables:                                                           #
#   $overridesByDevice  – deviceId  → array of overridden section strings    #
#   $devicePolicyMap    – deviceId  → effective policyId (for cross-ref)     #
# Then roll up WithOverrides count into each policy's deviceStats bucket.    #
###############################################################################

# Device name + effective policy lookup (built from the same device data)
$deviceNameMap   = @{}
$devicePolicyMap = @{}
foreach ($d in $allDevices) {
    $did  = [int]$d.id
    $deviceNameMap[$did] = if ($d.displayName) { $d.displayName }
                           elseif ($d.systemName) { $d.systemName }
                           else { "Device $did" }

    $rawPid2     = $d.policyId
    $isAssigned2 = ($null -ne $rawPid2) -and ("$rawPid2" -ne "") -and ([int]$rawPid2 -ne 0)
    $devicePolicyMap[$did] = if ($isAssigned2) { [int]$rawPid2 } else { [int]$d.rolePolicyId }
}

# deviceId → list of overridden section strings
$overridesByDevice = @{}
foreach ($row in $allOverrides) {
    $did = [int]$row.deviceId
    $overridesByDevice[$did] = $row.overrides   # array of strings

    # Roll up into the policy's WithOverrides counter
    if ($devicePolicyMap.ContainsKey($did)) {
        $polId2 = $devicePolicyMap[$did]
        if ($deviceStats.ContainsKey($polId2)) {
            $deviceStats[$polId2]['WithOverrides']++
        }
    }
}

$totalWithOverrides = $allOverrides.Count

