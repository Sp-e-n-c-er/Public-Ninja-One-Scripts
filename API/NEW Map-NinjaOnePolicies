$js = @'
<script>
function toggleNode(btn){
  btn.closest('li').classList.toggle('is-collapsed');
}
function expandAll(){
  document.querySelectorAll('#policyTree li').forEach(function(el){
    el.classList.remove('is-collapsed');
  });
}
function collapseAll(){
  document.querySelectorAll('#policyTree li').forEach(function(el){
    if(el.querySelector(':scope>ul')) el.classList.add('is-collapsed');
  });
}

// Search: match on policy name or node class text
function filterPolicies(){
  var q=document.getElementById('searchInput').value.toLowerCase().trim();
  var all=document.querySelectorAll('#policyTree li');
  all.forEach(function(li){
    if(li.classList.contains('unused-hidden')) return;
    var name=(li.querySelector('.policy-name')||{innerText:''}).innerText.toLowerCase();
    var nc  =(li.querySelector('.nc-badge')   ||{innerText:''}).innerText.toLowerCase();
    li.classList.toggle('is-hidden', q!=='' && name.indexOf(q)===-1 && nc.indexOf(q)===-1);
  });
  // Reveal parents of visible items
  if(q!==''){
    all.forEach(function(li){
      if(!li.classList.contains('is-hidden') && !li.classList.contains('unused-hidden')){
        var p=li.parentElement;
        while(p && p.id!=='policyTree'){
          if(p.tagName==='LI'){p.classList.remove('is-hidden');}
          p=p.parentElement;
        }
      }
    });
  }
}

// Hide / show policies with zero devices
var unusedHidden = false;
function toggleUnused(){
  unusedHidden = !unusedHidden;
  var btn=document.getElementById('btnUnused');
  btn.classList.toggle('active', unusedHidden);
  btn.textContent = unusedHidden ? 'Show Unused' : 'Hide Unused';
  document.querySelectorAll('#policyTree li').forEach(function(li){
    var total = parseInt(li.getAttribute('data-total')||'0', 10);
    if(total === 0){
      li.classList.toggle('unused-hidden', unusedHidden);
      li.classList.toggle('is-hidden',     unusedHidden);
    }
  });
}
</script>
'@

