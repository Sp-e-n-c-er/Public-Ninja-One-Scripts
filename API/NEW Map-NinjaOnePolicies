###############################################################################
#  REST HELPERS                                                               #
###############################################################################
function Invoke-NinjaGet {
    param([string]$Endpoint)
    try {
        return Invoke-RestMethod -Uri "$NinjaBaseUrl$Endpoint" -Headers $authHeader -Method Get -ErrorAction Stop
    } catch {
        Write-Warning "GET $Endpoint failed: $_"
        return @()
    }
}

function Invoke-NinjaPagedGet {
    param([string]$Endpoint)
    $results = [System.Collections.Generic.List[object]]::new()
    $after   = $null
    do {
        $qs  = "pageSize=$PageSize" + $(if ($after) { "&after=$after" } else { "" })
        $uri = "$NinjaBaseUrl$Endpoint`?$qs"
        try {
            $page = Invoke-RestMethod -Uri $uri -Headers $authHeader -Method Get -ErrorAction Stop
        } catch {
            Write-Warning "Paged GET $Endpoint failed: $_"
            break
        }
        if (-not $page -or $page.Count -eq 0) { break }
        $results.AddRange([object[]]$page)
        if ($page.Count -lt $PageSize) { break }
        $after = ($page | Select-Object -Last 1).id
    } while ($true)
    return $results.ToArray()
}

function Invoke-NinjaCursorGet {
    # Used for endpoints that return { cursor: {...}, results: [...] }
    # e.g. /v2/queries/policy-overrides
    param([string]$Endpoint)
    $results    = [System.Collections.Generic.List[object]]::new()
    $cursorName = $null
    do {
        $qs  = "pageSize=$PageSize" + $(if ($cursorName) { "&cursor=$cursorName" } else { "" })
        $uri = "$NinjaBaseUrl$Endpoint`?$qs"
        try {
            $resp = Invoke-RestMethod -Uri $uri -Headers $authHeader -Method Get -ErrorAction Stop
        } catch {
            Write-Warning "Cursor GET $Endpoint failed: $_"
            break
        }
        $page = $resp.results
        if (-not $page -or $page.Count -eq 0) { break }
        $results.AddRange([object[]]$page)
        if ($page.Count -lt $PageSize) { break }
        $cursorName = $resp.cursor.name
    } while ($cursorName)
    return $results.ToArray()
}

