$policiesUnused      = $TotalPolicyCount - $policiesWithDevices
$totalStale          = ($deviceStats.Values | ForEach-Object { $_['Stale'] } | Measure-Object -Sum).Sum

###############################################################################
#  POLICY TREE BUILDER                                                        #
###############################################################################
function Get-PolicyTree {
    param($policies, $parentId = $null)
    $children = $policies | Where-Object { $_.parentPolicyId -eq $parentId }
    foreach ($child in $children) {
        $child | Add-Member -MemberType NoteProperty -Name 'Children' -Value @() -Force
        $polId = [int]$child.id
        $stats = if ($deviceStats.ContainsKey($polId)) { $deviceStats[$polId] }
                 else { @{ Total=0; Inherited=0; Assigned=0; Stale=0; WithOverrides=0; Orgs=@() } }
        $child | Add-Member -MemberType NoteProperty -Name 'Stats' -Value $stats -Force
        $child.Children = Get-PolicyTree -policies $policies -parentId $child.id
    }
    return $children
}

